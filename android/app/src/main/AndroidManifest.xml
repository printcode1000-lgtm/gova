<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:replace="android:allowBackup,android:dataExtractionRules,android:fullBackupContent"
        tools:remove="android:requestLegacyExternalStorage">

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_asol_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <!--
            Android notification delivery is application-owned.

            The Capacitor plugin's MessagingService is removed and replaced by
            AsolPushMessagingService. The reason is not preference: a message
            Firebase displays itself never reaches onMessageReceived, so nothing
            can record it while the app is backgrounded or dead — which is
            exactly when a notification most needs recording. ASOL therefore
            sends Android a data-only message and does the display itself, after
            persisting the payload to the local app-private inbox (encrypted
            with AndroidKeyStore when the keystore is available).

            Two services must never both claim MESSAGING_EVENT: Firebase
            delivers to exactly one, chosen by manifest resolution order, so
            leaving both declared makes delivery depend on merge order.

            iOS/APNs and Web Push are untouched by this and keep their normal
            alert payloads.
        -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <service
            android:name=".AsolPushMessagingService"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter android:priority="1">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Verified public product/profile links from Google Play builds. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="gova-swart.vercel.app"
                    android:path="/s/product" />
                <data
                    android:scheme="https"
                    android:host="gova-swart.vercel.app"
                    android:path="/s/profile" />
            </intent-filter>

            <!--
                Share & Receive: place ASOL in the system share sheet.
                Handled by ShareReceivePlugin and delivered to the web layer
                through the Native Platform Share module.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!--
                Multiple Office documents. Kept in step with the single-item
                SEND filter above and with NSExtensionActivationRule on iOS.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Speech Recognition (voice-to-text only; no audio is recorded or stored) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Required by the in-app ML Kit barcode scanner. Because it is declared,
      Capacitor Camera also requests this alias before opening the camera app.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Location: foreground only. Background location is not requested. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Notifications: runtime permission required from Android 13 (API 33). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Local notification scheduling across reboots -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Google Play policy: broad media access is not allowed for one-off image
      selection. ASOL picks images through the Android Photo Picker
      (Capacitor Camera 8 -> IONCAMROpenPhotoPickerActivity, backported to
      older releases by the Play Services photopicker module), which returns a
      scoped content URI and therefore needs no media permission at all.

      These entries declare nothing. They are merger directives that strip the
      permission if any library or a future `npx cap sync` reintroduces it, so
      the shipped AAB can never regain broad media access by accident.
      Verify with: android/app/build/outputs/logs/manifest-merger-release-report.txt
    -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <!-- Camera is optional: the app must install on devices without one. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Allow the Files module to query apps that can open a shared document. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
</manifest>
