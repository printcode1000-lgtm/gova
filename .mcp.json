{
  "mcpServers": {
    "augment-context-engine": {
      "command": "npx",
      "args": [
        "-y",
        "auggie-context-mcp"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "/home/hesham/gova"
      ]
    },
    "sourcegraph": {
      "command": "npx",
      "args": [
        "-y",
        "@sourcegraph/mcp-server"
      ]
    }
  }
}
