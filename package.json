    "test:native-platform": "npx tsx src/native-platform/tests/native-platform-contract.test.ts && npx tsx src/native-platform/tests/capability-registry.test.ts",
    "test:feature-flags": "npx tsx src/features/feature-flags/tests/feature-flag-service.test.ts",
    "test:ota-delivery": "npx tsx src/features/ota/tests/ota-delivery.test.ts",
    "test:ota-background": "npx tsx src/features/ota/tests/ota-background-delivery.test.ts",
