    "cap:open:ios": "npx cap open ios",
    "cap:build": "npx tsx scripts/cap-build.ts",
    "cap:build:resume": "npx tsx scripts/cap-build.ts --resume",
    "cap:build:local": "npx tsx scripts/cap-build-local.ts",
    "fastlane": "node scripts/fastlane-runner.js",
    "fastlane:android:doctor": "node scripts/fastlane-runner.js android doctor",
    "fastlane:android:build": "node scripts/fastlane-runner.js android build",
    "fastlane:android:aab:signed": "node scripts/fastlane-runner.js android aab_signed",
    "fastlane:android:aab:unsigned": "node scripts/fastlane-runner.js android aab_unsigned",
    "fastlane:android:apk:signed": "node scripts/fastlane-runner.js android apk_signed",
    "fastlane:android:apk:unsigned": "node scripts/fastlane-runner.js android apk_unsigned",
    "fastlane:android:internal": "node scripts/fastlane-runner.js android internal",
    "fastlane:android:production": "node scripts/fastlane-runner.js android production",
    "fastlane:ios:build": "node scripts/fastlane-runner.js ios build",
    "fastlane:ios:testflight": "node scripts/fastlane-runner.js ios beta",
    "cap:verify-defaults": "npx tsx scripts/audit-capacitor-defaults.ts && npm run android:backup:validate && npm run android:r8:validate && npm run ios:push:validate",
    "cap:run:clean:android": "npx tsx scripts/cap-run-clean.ts android",
    "cap:run:clean:ios": "npx tsx scripts/cap-run-clean.ts ios"
