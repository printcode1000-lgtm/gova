{
  "version": 1,
  "authorization": {
    "commitMessageMarker": "[docs-contract-change]",
    "environmentVariable": "DOCS_CONTRACT_CHANGE",
    "default": "deny",
    "description": "Protected documentation may change only when the commit message contains [docs-contract-change] or DOCS_CONTRACT_CHANGE=1 is set for local/CI tooling. Generated documentation must never be hand-edited."
  },
  "classes": {
    "protected": {
      "description": "Binding project rules, architecture/runtime contracts, agent workflow, documentation CI, mutability, and runtime-compatibility verification rules. Not editable during normal feature work.",
      "authorizationRequired": true
    },
    "editable": {
      "description": "Operational and application documentation that must stay current with behavior changes without redefining protected contracts.",
      "authorizationRequired": false
    },
    "generated": {
      "description": "Overwrite-only outputs produced by generators. Never hand-edit.",
      "authorizationRequired": false,
      "handEditForbidden": true
    }
  },
