opt_out_usage

require "json"
require "base64"
require "tmpdir"

default_platform(:android)

APP_ROOT = File.expand_path("..", __dir__)

def root_path(relative_path)
  File.expand_path(relative_path.to_s, APP_ROOT)
end

def ensure_file!(label, relative_path)
  UI.user_error!("#{label} is not configured") if relative_path.to_s.strip.empty?
  path = root_path(relative_path)
  UI.user_error!("#{label} was not found at #{path}") unless File.exist?(path)
  path
end

def google_play_key_data
  raw = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64"].to_s.strip
  return nil if raw.empty?
  Base64.decode64(raw)
end

def google_play_temp_key_path
  data = google_play_key_data
  return nil if data.to_s.strip.empty?

  @google_play_temp_key_path ||= begin
    path = File.join(Dir.tmpdir, "asol-google-play-#{Process.pid}.json")
    File.write(path, data)
    at_exit { File.delete(path) if File.exist?(path) }
    path
  end
end

def google_play_key_path
  google_play_temp_key_path || ENV.fetch("GOOGLE_PLAY_JSON_KEY_FILE", "assets/google-play/asole-73f1f-dc494a4b5159.json")
end

def google_play_key_options
  { json_key: google_play_key_path }
end

def android_keystore_path
  ENV.fetch("ASOL_ANDROID_KEYSTORE_FILE", "assets/google-play/k.jks")
end

def check_google_play_key!
  path = ensure_file!("Google Play service account JSON", google_play_key_path)
  json = JSON.parse(File.read(path))
  expected_email = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL"]
  if expected_email.to_s.strip.length > 0 && json["client_email"] != expected_email
    UI.user_error!("Google Play JSON email does not match #{expected_email}")
  end
  UI.success("Google Play service account key is present")
end

def check_android_signing!
  ensure_file!("Android release keystore", android_keystore_path)
  missing = %w[
    ASOL_ANDROID_KEYSTORE_PASSWORD
    ASOL_ANDROID_KEY_ALIAS
    ASOL_ANDROID_KEY_PASSWORD
  ].select { |key| ENV[key].to_s.strip.empty? }
  UI.user_error!("Android signing is missing: #{missing.join(", ")}") unless missing.empty?
  UI.success("Android signing environment is present")
end

def run_command(command)
  UI.command(command)
  sh(command)
end

def npm_run(script)
  run_command("npm run #{script}")
end

def capacitor_sync(platform)
  npm_run("build:static")
  npm_run("android:push:sync-assets") if platform == :android
  run_command("npx cap sync #{platform}")
end

def without_android_signing
  keys = %w[
    ASOL_ANDROID_KEYSTORE_PASSWORD
    ASOL_ANDROID_KEY_ALIAS
    ASOL_ANDROID_KEY_PASSWORD
    ASOL_ANDROID_KEYSTORE_FILE
  ]
  previous = keys.to_h { |key| [key, ENV[key]] }
  keys.each { |key| ENV.delete(key) }
  yield
ensure
  previous.each do |key, value|
    if value.nil?
      ENV.delete(key)
    else
      ENV[key] = value
    end
  end
end

platform :android do
  desc "Validate Android publishing prerequisites"
  lane :doctor do
    check_google_play_key!
    check_android_signing!
  end

  desc "Build Android release bundle without uploading"
  lane :build do
    doctor
    capacitor_sync(:android)
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release"
    )
  end

  desc "Build signed Android release bundle without uploading"
  lane :aab_signed do
    build
  end

  desc "Build unsigned Android release bundle without uploading"
  lane :aab_unsigned do
    check_google_play_key!
    capacitor_sync(:android)
    without_android_signing do
      gradle(
        project_dir: "android",
        task: "bundle",
        build_type: "Release"
      )
    end
  end

  desc "Build signed Android release APK without uploading"
  lane :apk_signed do
    doctor
    capacitor_sync(:android)
    gradle(
      project_dir: "android",
      task: "assemble",
      build_type: "Release"
    )
  end

  desc "Build unsigned Android release APK without uploading"
  lane :apk_unsigned do
    check_google_play_key!
    capacitor_sync(:android)
    without_android_signing do
      gradle(
        project_dir: "android",
        task: "assemble",
        build_type: "Release"
      )
    end
  end

  desc "Build signed Android releaseNoR8 bundle without uploading"
  lane :aab_signed_no_r8 do
    doctor
    capacitor_sync(:android)
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "ReleaseNoR8"
    )
  end

  desc "Build unsigned Android releaseNoR8 bundle without uploading"
  lane :aab_unsigned_no_r8 do
    check_google_play_key!
    capacitor_sync(:android)
    without_android_signing do
      gradle(
        project_dir: "android",
        task: "bundle",
        build_type: "ReleaseNoR8"
      )
    end
  end

  desc "Build signed Android releaseNoR8 APK without uploading"
  lane :apk_signed_no_r8 do
    doctor
    capacitor_sync(:android)
    gradle(
      project_dir: "android",
      task: "assemble",
      build_type: "ReleaseNoR8"
    )
  end

  desc "Build unsigned Android releaseNoR8 APK without uploading"
  lane :apk_unsigned_no_r8 do
    check_google_play_key!
    capacitor_sync(:android)
    without_android_signing do
      gradle(
        project_dir: "android",
        task: "assemble",
        build_type: "ReleaseNoR8"
      )
    end
  end

  desc "Upload Android bundle to Google Play internal track"
  lane :internal do
    build
    upload_to_play_store(
      track: ENV.fetch("GOOGLE_PLAY_TRACK", "internal"),
      **google_play_key_options,
      package_name: ENV.fetch("ASOL_ANDROID_PACKAGE_NAME", "hgh.asol.app"),
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload Android bundle to Google Play production track"
  lane :production do
    build
    upload_to_play_store(
      track: "production",
      **google_play_key_options,
      package_name: ENV.fetch("ASOL_ANDROID_PACKAGE_NAME", "hgh.asol.app"),
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  desc "Validate iOS publishing prerequisites"
  lane :doctor do
    missing = %w[ASOL_IOS_TEAM_ID FASTLANE_USER].select { |key| ENV[key].to_s.strip.empty? }
    UI.user_error!("iOS publishing is missing: #{missing.join(", ")}") unless missing.empty?
    UI.success("iOS publishing environment is present")
  end

  desc "Build iOS app archive without uploading. Requires macOS/Xcode."
  lane :build do
    doctor
    capacitor_sync(:ios)
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: ENV.fetch("ASOL_IOS_EXPORT_METHOD", "app-store"),
      output_directory: "ios/build/fastlane",
      output_name: "ASOL.ipa"
    )
  end

  desc "Upload iOS build to TestFlight. Requires macOS/Xcode and App Store Connect auth."
  lane :beta do
    build
    upload_to_testflight(
      ipa: "ios/build/fastlane/ASOL.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
