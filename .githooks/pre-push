#!/bin/sh
#
# Runs every check in `.githooks/pre-push.d/` and fails the push if any of them fails.
#
# Git allows exactly one `pre-push` hook file, so this dispatcher exists to keep that
# limit from forcing unrelated checks into one script. Each check is its own file with
# its own reason to change; this file only decides ordering and the overall verdict.
#
# Git feeds a `pre-push` hook one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# stdin can only be read once, so it is captured here and replayed into each check.
#
# Every check runs even after one fails — a push held back for two reasons should say so
# once rather than over two attempts.
#
# Emergency override for all of them: `git push --no-verify`.

hook_dir=$(dirname "$0")/pre-push.d
refs=$(cat)
failed=0

for check in "$hook_dir"/*; do
  [ -f "$check" ] || continue
  printf '%s\n' "$refs" | sh "$check" "$@" || failed=1
done

exit "$failed"
