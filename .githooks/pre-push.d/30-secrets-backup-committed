#!/bin/sh
#
# Refuses to push while the portable secrets backup in `config/` is uncommitted.
#
# `npm run secrets:backup` writes two files there — `secret-archive-latest.zip.enc` and
# `secret-archive-latest.zip.enc.private-key.pem` (`PORTABLE_ARCHIVE_PATH` and
# `PORTABLE_RECOVERY_KEY_PATH` in `packages/secrets-core/src/archive/archive-workspace.ts`).
# They are tracked on purpose: the point of the portable backup is that a fresh clone can
# restore the project's secrets, and a backup that never left the machine that made it is
# not a backup. A regenerated archive left sitting in the working tree means GitHub still
# carries the previous one, and a restore elsewhere silently gets stale secrets.
#
# `deploy:all` runs `secrets:backup` as part of `publish`, so this check also catches a
# release whose archive was regenerated but not staged.
#
# Full rationale: docs/01-architecture/data-layers/22-scripts-and-workflows.md

# Drain the dispatcher's ref lines; this check inspects the working tree, not the refs.
cat >/dev/null

dirty=$(git status --porcelain -- config/secret-archive-latest.zip.enc config/secret-archive-latest.zip.enc.private-key.pem)

if [ -n "$dirty" ]; then
  echo "pre-push: the portable secrets backup in config/ is uncommitted." >&2
  echo "" >&2
  printf '%s\n' "$dirty" >&2
  echo "" >&2
  echo "Every secrets:backup output must reach GitHub, or a restore elsewhere gets stale" >&2
  echo "secrets. Commit it and push again:" >&2
  echo "  git add config/secret-archive-latest.zip.enc* && git commit -m 'chore(secrets): refresh portable backup'" >&2
  echo "" >&2
  echo "Override with 'git push --no-verify' only if you intend to leave it behind." >&2
  exit 1
fi

exit 0
