{
  "order.created": {
    "title": "Order created",
    "body": "Your order {{orderNumber}} was created successfully.",
    "category": "orders",
    "priority": "high",
    "channels": ["in_app", "web_push", "android_push", "ios_push"],
    "targets": ["center", "badge", "popup", "orders", "buyer_dashboard"],
    "deepLink": { "href": "/orders/details?orderId={{orderId}}", "label": "View order" },
    "groupKey": "orders",
    "sound": "default"
  },
  "order.updated": {
    "title": "Order update",
    "body": "Order {{orderNumber}} changed to {{status}}.",
    "category": "orders",
    "priority": "normal",
    "channels": ["in_app", "web_push", "android_push", "ios_push"],
    "targets": ["center", "badge", "popup", "orders"],
    "deepLink": { "href": "/orders/details?orderId={{orderId}}", "label": "View order" },
    "groupKey": "orders",
    "sound": "default"
  },
