# ── Notifications service (separate Vercel deployment) ──
# Client-safe: the browser bridge posts signed grants to this origin. Baked into
# static and Capacitor bundles at build time; a native build without it cannot
# deliver push at all, so build-static.ts asserts it.
NEXT_PUBLIC_ASOL_NOTIFICATIONS_URL=
# Server-only. Signs the grants the browser carries; the notifications service
# verifies with the same value. Must match on both accounts. Falls back to
# ASOL_SESSION_SIGNING_SECRET when unset.
ASOL_NOTIFICATION_GRANT_SECRET=
# Server-only. Session signing, explicit so rotating the notification secrets
# never invalidates user sessions.
ASOL_SESSION_SIGNING_SECRET=
# Vercel API token for the notifications account (deploy scripts only).
VERCEL_NOTIFICATIONS_TOKEN=

# Fastlane / store publishing (server/local CI only; never expose to the client)
ASOL_ANDROID_PACKAGE_NAME=hgh.asol.app
GOOGLE_PLAY_JSON_KEY_FILE=
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=fastlane@asole-73f1f.iam.gserviceaccount.com
GOOGLE_PLAY_SERVICE_ACCOUNT_UNIQUE_ID=111043929087553456734
GOOGLE_PLAY_TRACK=internal
ASOL_ANDROID_KEYSTORE_FILE=assets/google-play/k.jks
ASOL_ANDROID_KEYSTORE_PASSWORD=
ASOL_ANDROID_KEY_ALIAS=
ASOL_ANDROID_KEY_PASSWORD=
ASOL_IOS_BUNDLE_ID=hgh.asol.app
ASOL_IOS_TEAM_ID=
ASOL_IOS_EXPORT_METHOD=app-store
FASTLANE_USER=
FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=
APP_STORE_CONNECT_API_KEY_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=

# Asset base path for subdirectory deploys (GitHub Pages: /asol). Leave empty for Vercel/root hosting.
ASOL_BASE_PATH=

