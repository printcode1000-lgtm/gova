[Unit]
Description=Gova GitHub Actions self-hosted runner 4
After=network-online.target

[Service]
WorkingDirectory=/home/hesham/gova/.local/github-runners/gova-runner-4
ExecStart=/home/hesham/gova/.local/github-runners/gova-runner-4/run.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
# Keep one runaway job inside its own cgroup. Without this the machine's
# out-of-memory killer resolves memory pressure across the whole session, which
# takes down several unrelated jobs at once; MemoryHigh throttles the offender
# instead, and MemoryMax stops it before it reaches that point.
MemoryHigh=3G
MemoryMax=4G
Environment=GOVA_LOCAL_WORKSPACE=/home/hesham/gova
Environment=GOVA_LOCAL_SECRET_READ=local-only
Environment=GOVA_LOCAL_SECRET_EXPORT=forbidden
Environment=GOVA_RUNNER_POOL_DIR=/home/hesham/gova/.local/github-runners
Environment=GOVA_AGENT_COORDINATION_DIR=/home/hesham/gova/.local/github-runners/gova-coordination

[Install]
WantedBy=default.target
