[Unit]
Description=Gova GitHub Actions self-hosted runner 5
After=network-online.target

[Service]
WorkingDirectory=/home/hesham/gova/.local/github-runners/gova-runner-5
ExecStart=/home/hesham/gova/.local/github-runners/gova-runner-5/run.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
Environment=GOVA_LOCAL_WORKSPACE=/home/hesham/gova
Environment=GOVA_LOCAL_SECRET_READ=local-only
Environment=GOVA_LOCAL_SECRET_EXPORT=forbidden
Environment=GOVA_RUNNER_POOL_DIR=/home/hesham/gova/.local/github-runners
Environment=GOVA_AGENT_COORDINATION_DIR=/home/hesham/gova/.local/github-runners/gova-coordination

[Install]
WantedBy=default.target
