[Unit]
Description=Gova GitHub Actions self-hosted runner 6
After=network-online.target

[Service]
WorkingDirectory=/home/hesham/gova/.local/github-runners/gova-runner-6
ExecStart=/home/hesham/gova/.local/github-runners/gova-runner-6/run.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
Slice=gova-runners.slice
# Two bounds, and they answer different questions. The per-unit limits below keep
# one runaway job inside its own cgroup. The slice bounds what the whole pool may
# hold at once, which is what the kills were actually about: three ordinary jobs
# adding up past the point where the machine's out-of-memory killer acts across
# the entire session.
MemoryHigh=3G
MemoryMax=4G
Environment=GOVA_LOCAL_WORKSPACE=/home/hesham/gova
Environment=GOVA_LOCAL_SECRET_READ=local-only
Environment=GOVA_LOCAL_SECRET_EXPORT=forbidden
Environment=GOVA_RUNNER_POOL_DIR=/home/hesham/gova/.local/github-runners
Environment=GOVA_AGENT_COORDINATION_DIR=/home/hesham/gova/.local/github-runners/gova-coordination

[Install]
WantedBy=default.target
