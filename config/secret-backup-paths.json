{
  "exactPaths": [
    ".env",
    ".env.local",
    ".git_deploy_key",
    ".git_deploy_key.pub",
    ".ssh_config",
    "android/app/google-services.json",
    "android/key.properties",
    "android/local.properties",
    "ios/App/App/GoogleService-Info.plist",
    "fastlane/play-store-key.json"
  ],
  "pathPrefixes": [".ota/", ".ssh_local/"],
  "fileNames": [
    ".npmrc",
    "google-services.json",
    "GoogleService-Info.plist",
    "key.properties",
    "local.properties",
    "play-store-key.json"
  ],
  "extensions": [
    ".jks",
    ".keystore",
    ".p8",
    ".p12",
    ".pem",
    ".key",
    ".mobileprovision",
    ".cer"
  ],
  "namePatterns": [
    "^\\.env($|\\.)",
    "^AuthKey_.*\\.p8$",
    "^(service-account|firebase-admin|credentials|secrets).*\\.json$"
  ]
}
