{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@asol/native-core": [
        "./packages/native-core/src/index.ts"
      ],
      "@asol/ota-core": [
        "./packages/ota-core/src/index.ts"
      ],
      "@asol/ota-core/publishing": [
        "./packages/ota-core/src/publishing.ts"
      ],
      "@asol/ota-core/server": [
        "./packages/ota-core/src/server.ts"
      ],
      "@asol/storage-core": [
        "./packages/storage-core/src/index.ts"
      ],
      "@asol/storage-core/server": [
        "./packages/storage-core/src/server.ts"
      ],
      "@asol/account-bridge": [
        "./packages/account-bridge/src/index.ts"
      ],
      "@asol/account-bridge/notifications": [
        "./packages/account-bridge/src/notifications.ts"
      ],
      "@asol/vercel-deploy-core": [
        "./packages/vercel-deploy-core/src/index.ts"
      ],
      "@asol/service-mirror-core": [
        "./packages/service-mirror-core/src/index.ts"
      ],
      "@asol/notifications-composition": [
        "./packages/notifications-composition/src/index.ts"
      ],
      "@asol/orders-composition": [
        "./packages/orders-composition/src/index.ts"
      ],
      "@asol/products-composition": [
        "./packages/products-composition/src/index.ts"
      ],
      "@asol/profiles-composition": [
        "./packages/profiles-composition/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    ".next/dev/types/**/*.ts",
    "scripts",
    "packages/native-core/scripts",
    "**/__tests__/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "services"
  ]
}
