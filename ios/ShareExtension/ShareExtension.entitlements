<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Must match the App Group enabled on the main App target.
		Both targets need this identical value or the extension cannot hand
		received content to the application.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.hgh.asol.app</string>
	</array>
</dict>
</plist>
