{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 3
    },
    "database": {
      "type": "string",
      "const": "profile-core"
    },
    "table": {
      "type": "string",
      "const": "user_specialties"
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "subcategory",
              "doctor-specialty",
              "collection-member",
              "direct-category"
            ]
          },
          "mainId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "childId": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "column": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "required": [
          "key",
          "kind",
          "mainId",
          "childId",
          "column"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "database",
    "table",
    "mappings"
  ],
  "additionalProperties": false
}
