{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 3
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "datasets": {
      "type": "object",
      "properties": {
        "core": {
          "type": "object",
          "properties": {
            "categories": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9][a-z0-9_./-]*\\.json$"
            },
            "subcategories": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9][a-z0-9_./-]*\\.json$"
            },
            "collections": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9][a-z0-9_./-]*\\.json$"
            },
            "specialtyColumns": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9][a-z0-9_./-]*\\.json$"
            }
          },
          "required": [
            "categories",
            "subcategories",
            "collections",
            "specialtyColumns"
          ],
          "additionalProperties": false
        },
        "pharmacy": {
          "type": "object",
          "properties": {
            "categories": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9][a-z0-9_./-]*\\.json$"
            },
            "subcategories": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9][a-z0-9_./-]*\\.json$"
            },
            "ingredients": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9][a-z0-9_./-]*\\.json$"
            },
            "forms": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9][a-z0-9_./-]*\\.json$"
            },
            "strengths": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9][a-z0-9_./-]*\\.json$"
            }
          },
          "required": [
            "categories",
            "subcategories",
            "ingredients",
            "forms",
            "strengths"
          ],
          "additionalProperties": false
        },
        "vehicles": {
          "type": "object",
          "properties": {
            "groups": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-z0-9][a-z0-9_./-]*\\.json$"
            }
          },
          "required": [
            "groups"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "core",
        "pharmacy",
        "vehicles"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "mainCategories": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\/(?!.*\\.\\.)[A-Za-z0-9_./%&+() -]+$"
        },
        "subcategories": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\/(?!.*\\.\\.)[A-Za-z0-9_./%&+() -]+$"
        },
        "pharmacy": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\/(?!.*\\.\\.)[A-Za-z0-9_./%&+() -]+$"
        },
        "vehicles": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\/(?!.*\\.\\.)[A-Za-z0-9_./%&+() -]+$"
        }
      },
      "required": [
        "mainCategories",
        "subcategories",
        "pharmacy",
        "vehicles"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "catalogVersion",
    "datasets",
    "assets"
  ],
  "additionalProperties": false
}
