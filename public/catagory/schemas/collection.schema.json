{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 3
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "object",
            "properties": {
              "ar": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ar",
              "en"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "image": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*\\.\\.)[^/\\\\]+$"
          },
          "memberCategoryIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "display": {
            "type": "object",
            "properties": {
              "order": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "hidden": {
                "type": "boolean"
              }
            },
            "required": [
              "order",
              "hidden"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "image",
          "memberCategoryIds",
          "display"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "items"
  ],
  "additionalProperties": false
}
