# Dependencies
node_modules
.deploy-all/

# Build outputs
.next
out/
.backups/
.private-backups/
.secret-archive/
asol-secrets-manifest.json

# NOT ignored, on purpose — do not add it here:
#   config/secret-archive-latest.zip.enc.private-key.pem
# It is tracked so that downloading this repository as a ZIP onto a clean machine and
# running `secrets:restore` works with nothing but the passphrase. See
# docs/01-architecture/release-and-secrets-modules.md § "What is committed, and what is not".


# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.dev-release-console.out.log
.dev-release-console.err.log
tsconfig.tsbuildinfo

# Local env files
.env*.local
.env

# Chrome profile cache / heavy data (scripts in test_profile/ are tracked, but heavy caches/dumps stay out)
test_profile/manageProfile/
test_profile/**/Cache/
test_profile/**/Code Cache/
test_profile/**/GPUCache/

# Ephemeral agent worktrees. Never tracked: they carry a full checkout plus
# whatever secrets a session restored into it, including the Android signing
# keystore. `secrets:restore` refuses to write into a path Git does not ignore,
# so an archive entry under here needs this line to be restorable at all.
.claude/worktrees/

# IDE
.idea/
*.swp
*.swo
*~

# deploy:all phased run state (revision, completed phases)
.deploy-all/

# SSH deploy keys
.git_deploy_key
.git_deploy_key.pub
.ssh_config
.ssh_local/

# OS
.DS_Store
Thumbs.db

.vercel

# OTA signing material
.ota/

# Fastlane / store publishing credentials and generated packages
.bundle/
bin/
fastlane/.env*
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
fastlane/play-store-key.json
fastlane/app-store-connect-api-key*.p8
android/app/*.jks
android/app/*.keystore
ios/build/fastlane/

# Firebase server credentials and generated Android client config
assets/google-play/*firebase-adminsdk*.json
assets/google-play/google-services.json
assets/google-play/*.json
assets/google-play/*.jks
android/app/google-services.json
ios/App/App/GoogleService-Info.plist
android/app/src/main/res/raw/custom_notification.mp3

# Apple signing and push credentials.
# The APNs authentication key is a private signing key valid for every app
# under the team account. Upload it to Firebase Console, never to git.
*.p8
*.p12
*.mobileprovision
*.cer

.vercel
.env*
!.env.example
!fastlane/.env.example

# Notifications service: shared modules are copied in by
# scripts/sync-notifications-service-sources.ts on every deploy.
services/notifications/generated/
services/notifications/.next/
services/notifications/node_modules/
services/notifications/.vercel/

# Products service: shared modules are copied in by
# scripts/sync-products-service-sources.ts on every deploy.
services/products/generated/
services/products/.next/
services/products/node_modules/
services/products/.vercel/
services/products/src/config/

# Orders service: shared modules are copied in by
# scripts/sync-orders-service-sources.ts on every deploy.
services/orders/generated/
services/orders/.next/
services/orders/node_modules/
services/orders/.vercel/

# Profiles service: shared modules are copied in by
# scripts/sync-profiles-service-sources.ts on every deploy.
services/profiles/generated/
services/profiles/.next/
services/profiles/node_modules/
services/profiles/.vercel/
services/profiles/src/config/
.catalog-studio/

# Scratch and logs. These were tracked once: 25MB of agent build logs, dev-server
# output, and screenshots that no code or document references. They stay on disk
# and out of the repository.
tmp/
.codex-logs/
.dev-server.*.log

# Git bundles
*.bundle

# Runtime system-ops shard: generated locally by db:ensure and holds system logs /
# data-health records. Schema sync uses Turso; do not commit this SQLite file.
public/sync_data/sync_sqlite/system-ops.db

# Scratch tree for the static export build (packages/ota-core, `tempBuildDir`).
# It holds a rewritten copy of src/ and the Next `out/` while build:static runs,
# and survives on disk whenever that build is interrupted. Never committed.
.tmp-static-build/

# Local agent control plane runtime root. Holds the six GitHub Actions
# self-hosted runner installs, their _work checkouts, agent worktrees, and the
# coordination channel (locks, messages, agent registry, operation logs).
# Binaries, runner credentials, workspaces, and runtime state never get
# committed; only the scripts and workflows that drive them do.
.local/
