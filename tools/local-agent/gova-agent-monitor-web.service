[Unit]
Description=Gova Local Agents HTML Monitor
After=default.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=GOVA_AGENT_REPO=/home/hesham/gova
Environment=GOVA_AGENT_RUNTIME=/home/hesham/.local/share/gova-agent-runtime
Environment=GOVA_AGENT_WORKTREES=/home/hesham/gova-agents
ExecStart=/usr/bin/python3 /home/hesham/.local/lib/gova-agent/web_monitor.py --host 127.0.0.1 --port 8766
Restart=always
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
